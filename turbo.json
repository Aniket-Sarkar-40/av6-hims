{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@repo/db#build": {
      "dependsOn": ["prisma:generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "prisma:generate": {
      "cache": false,
      "outputs": ["generated/**"]
    },
    "prisma:migrate": {
      "cache": false
    }
  }
}
