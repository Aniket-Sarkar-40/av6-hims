{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "prisma.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "generated",
    "prisma/generated",
    "logs",
    "uploads",
    "coverage",
    ".turbo",
    ".cache",
    "tmp",
    "prisma/migrations"
  ]
}
