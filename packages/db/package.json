{
  "name": "@repo/db",
  "version": "0.0.1",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "av6-core": "^2.0.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "mariadb": "^3.4.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "development": "./src/client.ts",
      "default": "./dist/src/client.js"
    },
    "./generated/prisma/client": {
      "types": "./dist/generated/prisma/client.d.ts",
      "default": "./dist/generated/prisma/client.js"
    },
    "./generated/prisma/*": "./dist/generated/prisma/*",
    "./models/*": "./dist/generated/prisma/models/*"
  },
  "main": "./dist/src/index.js",
  "prisma": {
    "seed": "tsx seedRunner.ts"
  },
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.generated.json",
    "p:deploy": "prisma migrate deploy",
    "p:gen": "prisma generate",
    "p:mig": "prisma migrate dev",
    "p:seed": "prisma db seed",
    "p:studio": "prisma studio",
    "p:validate": "prisma validate"
  },
  "type": "module",
  "types": "./dist/src/index.d.ts"
}
