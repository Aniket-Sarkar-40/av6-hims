{
  "name": "@repo/db",
  "version": "0.0.1",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "mariadb": "^3.4.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./dist/src/client.js"
    },
    "./generated/prisma/client": {
      "types": "./generated/prisma/client.d.ts",
      "default": "./generated/prisma/client.js"
    },
    "./generated/prisma/*": "./generated/prisma/*",
    "./models/*": "./generated/prisma/models/*"
  },
  "main": "./dist/src/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "p:deploy": "prisma migrate deploy",
    "p:gen": "prisma generate",
    "p:mig": "prisma migrate dev",
    "p:studio": "prisma studio",
    "p:validate": "prisma validate"
  },
  "types": "./dist/src/index.d.ts"
}
