    affectsGrossProfit Boolean?                   @map("affects_gross_profit")

    batchJob BatchJob @relation(fields: [batchJobId], references: [id])

    @@index([batchJobId], map: "idx_group_excel_batch_job")
    @@map("accounting_group_excel")
}

model LedgerExcel {
    id         Int  @id @default(autoincrement())
    batchJobId Int  @map("batch_job_id")
    rowNo      Int? @map("row_no")

    name      String
    groupName String  @map("group_name")
    alias     String?

    ledgerType    LedgerType @default(GENERAL) @map("ledger_type")
    isBankAccount Boolean    @default(false) @map("is_bank_account")
    isCashAccount Boolean    @default(false) @map("is_cash_account")

    bankName      String? @map("bank_name")
    bankIfsc      String? @map("bank_ifsc")
    bankAccountNo String? @map("bank_account_no")
    upiId         String? @map("upi_id")

    contactName String? @map("contact_name")
    phone       String?
    email       String?
    address     String? @db.Text

    gstType                LedgerGstType @default(NA) @map("gst_type")
    gstin                  String?
    placeOfSupplyStateName String?       @map("place_of_supply_state_name")

    currencyCode String? @map("currency_code")

    batchJob BatchJob @relation(fields: [batchJobId], references: [id])

    @@index([batchJobId], map: "idx_ledger_excel_batch_job")
    @@map("accounting_ledger_excel")
}

model VoucherUINConfig {
    id             Int              @id @default(autoincrement())
    voucherTypeId  Int              @map("voucher_type_id")
    seqStartDate   DateTime         @map("seq_start_date") @db.Date
    sequenceNo     BigInt           @default(0) @map("sequence_no")
    seqResetDate   DateTime         @map("seq_reset_date") @db.Date
    seqResetPolicy UIN_RESET_POLICY @default(no) @map("seq_reset_policy")
    description    String?
    uinSegments    Json             @map("uin_segments")

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")

    voucherType VoucherType @relation(fields: [voucherTypeId], references: [id])

    @@index([voucherTypeId], map: "idx_voucher_uin_config_voucher_type")
    @@map("accounting_voucher_uin_config")
}

model ChequeMaster {
    id            Int    @id @default(autoincrement())
    bankLedgerId  Int    @map("bank_ledger_id")
    startChequeNo Int    @map("start_cheque_no")
    endChequeNo   Int    @map("end_cheque_no")
    status        Status @default(ACTIVE) @map("status")

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")

    bankLedger        Ledger             @relation(fields: [bankLedgerId], references: [id])
    usedChequeNumbers UsedChequeNumber[]

    @@index([bankLedgerId], map: "idx_cheque_master_bank_ledger")
    @@map("accounting_cheque_master")
}

model UsedChequeNumber {
    id             Int     @id @default(autoincrement())
    chequeMasterId Int     @map("cheque_master_id")
    voucherLineId  Int     @map("voucher_line_id")
    chequeNo       Int     @map("cheque_no")
    isUsed         Boolean @map("is_used")

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")

    chequeMaster ChequeMaster @relation(fields: [chequeMasterId], references: [id])
    voucherLine  VoucherLine  @relation(fields: [voucherLineId], references: [id])

    @@index([chequeMasterId], map: "idx_used_cheque_number_cheque_master")
    @@index([voucherLineId], map: "idx_used_cheque_number_voucher_line")
    @@map("accounting_used_cheque_number")
}
