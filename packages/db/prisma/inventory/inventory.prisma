    goodReceive          InvGoodReceive[]
    goodReceiveReturn    InvGoodReceiveReturn[]

    @@index([supplierId], name: "purchase_order_supplier_id_idx")
    @@index([storeId], name: "purchase_order_store_id_idx")
    @@index([ccId], name: "purchase_order_cc_id_idx")
    @@index([currencyId], name: "purchase_order_currency_id_idx")
    @@map("inv_purchase_order")
}

