model InvPurchaseOrder {
    id             Int       @id @default(autoincrement())
    poNumber       String    @map("po_number")
    date           DateTime  @db.Date
    supplierId     Int       @map("supplier_id")
    storeId        Int?      @map("store_id")
    ccId           Int       @map("cc_id")
    grandTotal     Float     @map("grand_total")
    status         PO_STATUS @default(SENT_FOR_APPROVAL)
    notes          String?   @db.Text
    currencyId     Int?      @map("currency_id")
    conversionRate Decimal?  @map("conversion_rate") @db.Decimal(18, 5)
    paymentTerms   String?   @map("payment_terms") @db.Text
    isActive       Boolean   @default(true) @map("is_active")
    createdBy      Int?      @map("created_by")
    updatedBy      Int?      @map("updated_by")
    deletedBy      Int?      @map("deleted_by")
    lastVerifiedBy Int?      @map("last_verified_by")
    lastVerifiedAt DateTime? @map("last_verified_at")
    createdAt      DateTime  @default(now()) @map("created_at")
    updatedAt      DateTime  @updatedAt @map("updated_at")
    deletedAt      DateTime? @map("deleted_at")

    supplier             InvItemSupplier           @relation(fields: [supplierId], references: [id])
    store                InvItemStore?             @relation(fields: [storeId], references: [id])
    collectionCenter     CollectionCenter          @relation(fields: [ccId], references: [id])
    currency             Currency?                 @relation(fields: [currencyId], references: [id])
