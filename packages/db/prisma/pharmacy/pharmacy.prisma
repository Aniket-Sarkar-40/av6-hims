    deliveryMethod ALERT_DELIVERY_METHOD @map("delivery_method")
    alertType      ALERT_TYPE            @map("alert_type")

    status         ALERT_STATUS @default(PENDING)
    errorMsg       String?      @map("error_msg") @db.Text
    isResend       Boolean      @default(false) @map("is_resend")
    resendMasterId Int?         @map("resend_master_id")
    successDate    DateTime?    @map("success_date")
    alertMode      ALERT_MODE   @default(SYSTEM) @map("alert_mode")

    createdAt DateTime           @default(now()) @map("created_at")
    updatedAt DateTime           @updatedAt @map("updated_at")
    createdBy Int?               @map("created_by")
    updatedBy Int?               @map("updated_by")
    recipient PmsAutoAlertEmail? @relation(fields: [recipientId], references: [id])

    @@index([recipientId], name: "auto_alert_audit_recipient_id_idx")
    @@map("pms_auto_alert_audit")
}
