model PmsItem {
    id Int @id @default(autoincrement())

    itemNumber          String?        @map("item_number")
    medicineName        String         @map("medicine_name")
    medCategoryId       Int            @map("medicine_category_id")
    storageId           Int?           @map("storage_id")
    boxSizeId           Int?           @map("box_size_id")
    medTypeId           Int            @map("medicine_type_id")
    medCompId           Int            @map("medicine_composition_id")
    medUnitId           Int            @map("medicine_unit_id")
    manufacturerId      Int            @map("manufacturer_id")
    minOrderDetails     String?        @map("min_order_details")
    rackLocation        String?        @map("rack_location")
    defaultDiscount     Decimal        @map("default_disc") @db.Decimal(13, 5)
    defaultB2BDiscount  Decimal        @map("default_b2b_disc") @db.Decimal(13, 5)
    isLockDiscount      Boolean        @default(false) @map("is_lock_disc")
    isLockB2BDiscount   Boolean        @default(false) @map("is_lock_b2b_disc")
    minStock            Int            @map("min_stock")
    maxStock            Int            @map("max_stock")
    tax                 Decimal        @map("tax") @db.Decimal(13, 5)
    taxMethod           TAX_METHOD     @map("tax_method")
    packSizeId          Int            @map("pack_size_id")
    drugTypeId          Int            @map("drug_type_id")
    isAllowLooseSale    Boolean        @default(false) @map("is_allow_loose_sale")
    acceptOnlineOrder   Boolean        @default(true) @map("accept_online_order")
    isReturnable        Boolean        @default(true) @map("is_returnable")
    isSuggestionLock    Boolean        @default(false) @map("is_suggestion_lock")
    cess                Float?
    hsnCode             String?        @map("hsn_code")
    status              PmsItemStatus  @default(AVAILABLE)
    purchaseAmount      Decimal        @map("purchase_amount") @db.Decimal(13, 5)
    saleAmount          Decimal        @map("sale_amount") @db.Decimal(13, 5)
    remark              String?
    onHoldSale          DateTime?      @map("on_hold_sale") @db.Date
    medPackingType      PmsMedPackType @map("medicine_pack_type")
    barcode             String?
    itemAlias           String?        @map("item_alias")
    tags                String?
    insurancePercentage Decimal        @map("insurance_percentage") @db.Decimal(13, 5)
    walkInPercentage    Decimal        @map("walk_in_percentage") @db.Decimal(13, 5)

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")

    medCategory  MedCategory   @relation(fields: [medCategoryId], references: [id])
    medType      MedType       @relation(fields: [medTypeId], references: [id])
    medComp      MedicineCompo @relation(fields: [medCompId], references: [id])
    medUnit      MedicineUnit  @relation(fields: [medUnitId], references: [id])
    packSize     MedPackage    @relation(fields: [packSizeId], references: [id])
    drugType     MedDrug       @relation(fields: [drugTypeId], references: [id])
    manufacturer Manufacture   @relation(fields: [manufacturerId], references: [id])
    storage      PmsStorage?   @relation(fields: [storageId], references: [id])
    boxSize      BoxSize?      @relation(fields: [boxSizeId], references: [id])

    itemImages                    ItemImages[]
    itemMedicineDosageMap         ItemMedicineDosageMap[]
    itemInstructionMap            ItemInstructionMap[]
    purchaseOrderDetails          PmsPurchaseOrderDetails[]
    medicineDistributorMap        MedicineDistributorMap[]
    storeRequisitionDetails       PmsStoreRequisitionDetails[]
    itemStock                     PmsItemStock[]
    goodReceiveDetails            PmsGoodReceiveDetails[]
    goodReceiveReturnDetails      PmsGoodReceiveReturnDetails[]
    stockTransferDetails          PmsStockTransferDetails[]
    requisitionItemDetails        PmsRequisitionItemDetails[]
    sellDetails                   PmsSellDetails[]
    sellReturnDetails             PmsSellReturnDetails[]
    branchSellAmountMap           BranchItemMap[]
    inTransitStock                PmsInTransitStock[]
    storeRequisitionReturnDetails PmsStoreRequisitionReturnDetails[]
    requisitionReturnItemDetails  PmsRequisitionReturnItemDetails[]

    @@index([medCategoryId], name: "med_category_id_idx")
    @@index([medCompId], name: "med_compo_id_idx")
    @@index([medTypeId], name: "med_type_id_idx")
    @@index([medUnitId], name: "med_unit_id_idx")
    @@index([packSizeId], name: "pack_size_id_idx")
    @@index([drugTypeId], name: "drug_type_id_idx")
    @@index([manufacturerId], name: "manufacturer_id_idx")
    @@index([storageId], name: "storage_id_idx")
    @@index([boxSizeId], name: "item_box_size_id_idx")
    @@map("pms_item")
}

model ItemMedicineDosageMap {
    id Int @id @default(autoincrement())

    itemId   Int @map("item_id")
    dosageId Int @map("dosage_id")
    qty      Int

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")

    item      PmsItem        @relation(fields: [itemId], references: [id])
    medDosage MedicineDosage @relation(fields: [dosageId], references: [id])

    @@unique([itemId, dosageId])
    @@index([dosageId], name: "item_medicine_dosage_map_dosage_id_idx")
    @@map("pms_item_dosage_map")
}

