model BloodBankSettings {
    id Int @id @default(autoincrement())

    isEmail                Boolean           @default(true) @map("is_email")
    isSMS                  Boolean           @default(false) @map("is_sms")
    isWhatsapp             Boolean           @default(false) @map("is_whatsapp")
    expiryInMonth          Int               @map("expiry_in_month")
    countryCode            String?           @map("county_code")
    slowMovingTimeInMonth  Int?              @map("slow_moving_time_in_month")
    batchSize              Int               @default(100) @map("batch_size")
    defaultPrecision       Int               @default(2) @map("default_precision")
    grnCalculationMethod   CalculationMethod @default(FINAL) @map("grn_calculation_method")
    sellCalculationMethod  CalculationMethod @default(FINAL) @map("sell_calculation_method")
    grnRoundedFormat       RoundFormat       @default(TO_FIXED) @map("grn_rounded_format")
    sellRoundedFormat      RoundFormat       @default(ROUND) @map("sell_rounded_format")
    sellFinalRoundedFormat RoundFormat       @default(SPECIAL_ROUND) @map("sell_final_round_format")
    grnFinalRoundedFormat  RoundFormat       @default(TO_FIXED) @map("grn_final_round_format")

    isActive Boolean @default(true) @map("is_active")

    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")

    @@map("blood_bank_settings")
}

model BloodBankDynamicShortCode {
    id           Int      @id @default(autoincrement())
    shortCode    String   @unique @map("short_code")
    tableName    String   @map("table_name")
    isDTO        Boolean  @default(false) @map("is_dto")
    isCacheable  Boolean  @default(false) @map("is_cacheable")
    isDropDown   Boolean  @default(false) @map("is_drop_down")
    permission   String?
    whereClause  Json?    @map("where_clause")
    selectClause Json?    @map("select_clause")
    config       Json?    @map("config")
    isSingleDto  Boolean  @default(true) @map("is_single_dto")
    createdBy    Int?     @map("created_by")
    updatedBy    Int?     @map("updated_by")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    @@map("blood_bank_dynamic_short_code")
}

model BloodBankUINConfig {
    id             Int                   @id @default(autoincrement())
    shortCode      BloodBankUinShortCode @map("short_code")
    sequenceNo     BigInt                @default(0) @map("sequence_no")
    seqResetDate   DateTime              @map("seq_reset_date") @db.Date
    seqResetPolicy UIN_RESET_POLICY      @default(no) @map("seq_reset_policy")
    description    String?
    uinSegments    Json                  @map("uin_segments")
    isActive       Boolean               @default(true) @map("is_active")
    createdBy      Int?                  @map("created_by")
    updatedBy      Int?                  @map("updated_by")
    createdAt      DateTime              @default(now()) @map("created_at")
    updatedAt      DateTime              @updatedAt @map("updated_at")
    deletedAt      DateTime?             @map("deleted_at")
    deletedBy      Int?                  @map("deleted_by")

    @@map("blood_bank_uin_config")
}
