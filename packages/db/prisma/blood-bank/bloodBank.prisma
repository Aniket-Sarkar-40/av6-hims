model BloodBankDynamicShortCode {
    id           Int      @id @default(autoincrement())
    shortCode    String   @unique @map("short_code")
    tableName    String   @map("table_name")
    isDTO        Boolean  @default(false) @map("is_dto")
    isCacheable  Boolean  @default(false) @map("is_cacheable")
    isDropDown   Boolean  @default(false) @map("is_drop_down")
    permission   String?
    whereClause  Json?    @map("where_clause")
    selectClause Json?    @map("select_clause")
    config       Json?    @map("config")
    isSingleDto  Boolean  @default(true) @map("is_single_dto")
    createdBy    Int?     @map("created_by")
    updatedBy    Int?     @map("updated_by")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    @@map("bb_dynamic_short_code")
}

model BloodBankUINConfig {
    id             Int                   @id @default(autoincrement())
    shortCode      BloodBankUinShortCode @map("short_code")
    sequenceNo     BigInt                @default(0) @map("sequence_no")
    seqResetDate   DateTime              @map("seq_reset_date") @db.Date
    seqResetPolicy UIN_RESET_POLICY      @default(no) @map("seq_reset_policy")
    description    String?
    uinSegments    Json                  @map("uin_segments")
    isActive       Boolean               @default(true) @map("is_active")
    createdBy      Int?                  @map("created_by")
    updatedBy      Int?                  @map("updated_by")
    createdAt      DateTime              @default(now()) @map("created_at")
    updatedAt      DateTime              @updatedAt @map("updated_at")
    deletedAt      DateTime?             @map("deleted_at")
    deletedBy      Int?                  @map("deleted_by")

    @@map("bb_bank_uin_config")
}

model BloodBankSetting {
    id Int @id @default(autoincrement())

    isCrossMatchRequired                 Boolean @default(true) @map("is_cross_match_required")
    allowEmergencyIssueWithoutCrossMatch Boolean @default(true) @map("allow_emergency_issue_without_cross_match")

    isTransfusionTrackingRequired Boolean @default(false) @map("is_transfusion_tracking_required")
    isTransfusionVitalsRequired   Boolean @default(false) @map("is_transfusion_vitals_required")
    isTransfusionReactionRequired Boolean @default(false) @map("is_transfusion_reaction_required")

    reservationExpiryMinutes Int?    @map("reservation_expiry_minutes")
    allowReservationReversal Boolean @default(true) @map("allow_reservation_reversal")

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    deletedBy Int?      @map("deleted_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    @@map("bb_settings")
}
