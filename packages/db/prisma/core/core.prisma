model StaffMapping {
    id            Int               @id @default(autoincrement())
    staffId       Int               @unique @map("staff_id")
    designationId Int?              @map("designation_id")
    departmentId  Int?              @map("department_id")
    isActive      Boolean           @default(true) @map("is_active")
    createdBy     Int?              @map("created_by")
    updatedBy     Int?              @map("updated_by")
    createdAt     DateTime          @default(now()) @map("created_at")
    updatedAt     DateTime?         @updatedAt @map("updated_at")
    deletedAt     DateTime?         @map("deleted_at")
    deletedBy     Int?              @map("deleted_by")
    staff         Staff             @relation(fields: [staffId], references: [id])
    designation   StaffDesignation? @relation(fields: [designationId], references: [id])
    Department    Department?       @relation(fields: [departmentId], references: [id])

    @@index([designationId], name: "StaffEmployee_designationId_idx")
    @@index([departmentId], name: "StaffEmployee_departmentId_idx")
    @@index([staffId], name: "StaffEmployee_staffId_idx")
    @@map("core_staff_employee")
}

model StaffDesignation {
    id            Int            @id @default(autoincrement())
    designation   String         @db.VarChar(200)
    isActive      String         @map("is_active") @db.VarChar(100)
    staffEmployee StaffMapping[]

    @@map("staff_designation")
}

model Department {
    id              Int            @id @default(autoincrement())
    name            String         @map("department_name") @db.VarChar(200)
    deptId          String         @map("dept_id") @db.VarChar(50)
    deptDisplayText String         @map("dept_display_text") @db.VarChar(100)
    deptSequence    Int            @map("dept_sequence")
    isSample        BinaryFlag     @map("is_sample")
    isAnalyte       BinaryFlag?    @map("is_analyte")
    masterDept      Int            @map("master_dept")
    tatData         String?        @map("tat_data") @db.LongText
    printInTrs      YesNoFlag      @default(yes) @map("print_in_trs")
    isActive        YesNoFlag      @map("is_active")
    staffEmployee   StaffMapping[]

    // For Alma
    designation String? @map("designation") @db.VarChar(255)

    @@map("department")
}

model Currency {
    id        Int       @id @default(autoincrement())
    code      String
    name      String
    symbol    String
    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    deletedBy Int?      @map("deleted_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime? @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    @@map("core_currency")
