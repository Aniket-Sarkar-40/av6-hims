model CoreSettings {
    id Int @id @default(autoincrement())

    isEmail                Boolean           @default(true) @map("is_email")
    isSMS                  Boolean           @default(false) @map("is_sms")
    isWhatsapp             Boolean           @default(false) @map("is_whatsapp")
    expiryInMonth          Int               @map("expiry_in_month")
    countryCode            String?           @map("county_code")
    slowMovingTimeInMonth  Int?              @map("slow_moving_time_in_month")
    batchSize              Int               @default(100) @map("batch_size")
    defaultPrecision       Int               @default(2) @map("default_precision")
    grnCalculationMethod   CalculationMethod @default(FINAL) @map("grn_calculation_method")
    sellCalculationMethod  CalculationMethod @default(FINAL) @map("sell_calculation_method")
    grnRoundedFormat       RoundFormat       @default(TO_FIXED) @map("grn_rounded_format")
    sellRoundedFormat      RoundFormat       @default(ROUND) @map("sell_rounded_format")
    sellFinalRoundedFormat RoundFormat       @default(SPECIAL_ROUND) @map("sell_final_round_format")
    grnFinalRoundedFormat  RoundFormat       @default(TO_FIXED) @map("grn_final_round_format")

    isActive Boolean @default(true) @map("is_active")

    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")

    @@map("core_settings")
}

model CoreDynamicShortCode {
    id           Int      @id @default(autoincrement())
    shortCode    String   @unique @map("short_code")
    tableName    String   @map("table_name")
    isDTO        Boolean  @default(false) @map("is_dto")
    isCacheable  Boolean  @default(false) @map("is_cacheable")
    isDropDown   Boolean  @default(false) @map("is_drop_down")
    permission   String?
    whereClause  Json?    @map("where_clause")
    selectClause Json?    @map("select_clause")
    config       Json?    @map("config")
    isSingleDto  Boolean  @default(true) @map("is_single_dto")
    createdBy    Int?     @map("created_by")
    updatedBy    Int?     @map("updated_by")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    @@map("core_dynamic_short_code")
}

model CoreUINConfig {
    id             Int              @id @default(autoincrement())
    shortCode      CoreUinShortCode @map("short_code")
    sequenceNo     BigInt           @default(0) @map("sequence_no")
    seqResetDate   DateTime         @map("seq_reset_date") @db.Date
    seqResetPolicy UIN_RESET_POLICY @default(no) @map("seq_reset_policy")
    description    String?
    uinSegments    Json             @map("uin_segments")
    isActive       Boolean          @default(true) @map("is_active")
    createdBy      Int?             @map("created_by")
    updatedBy      Int?             @map("updated_by")
    createdAt      DateTime         @default(now()) @map("created_at")
    updatedAt      DateTime         @updatedAt @map("updated_at")
    deletedAt      DateTime?        @map("deleted_at")
    deletedBy      Int?             @map("deleted_by")

    @@map("core_uin_config")
}

model Country {
    id          Int     @id @default(autoincrement()) @map("num_code")
    alpha2Code  String? @map("alpha_2_code")
    alpha3Code  String? @map("alpha_3_code")
    enShortName String? @map("en_short_name")
    nationality String? @map("nationality")

    state       State[] // Relation to states
    cities      City[] // Relation to cities
    CountryCode CountryCode?

    @@map("countries")
}

model State {
    id        Int       @id @default(autoincrement())
    name      String
    countryId Int       @map("country_id")
    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")
    country   Country   @relation(fields: [countryId], references: [id])
    cities    City[]

    @@index([countryId], name: "state_country_id_idx")
    @@map("master_state")
}

model City {
    id        Int       @id @default(autoincrement())
    name      String
    stateId   Int       @map("state_id")
    countryId Int       @map("country_id")
    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")
    state     State     @relation(fields: [stateId], references: [id])
    country   Country   @relation(fields: [countryId], references: [id])

    @@index([stateId], name: "city_state_id_idx")
    @@index([countryId], name: "city_countryId_id_idx")
    @@map("master_city")
}

model CountryCode {
    id          Int    @id @default(autoincrement())
    countryCode String @unique @map("country_code")
    countryId   Int    @unique @map("country_id")

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedBy Int?      @map("updated_by")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedBy Int?      @map("deleted_by")
    deletedAt DateTime? @map("deleted_at")
    country   Country   @relation(fields: [countryId], references: [id], map: "core_country_code_country_id_fk")

    @@index([countryId], name: "core_country_code_country_id_idx")
    @@map("core_country_code")
}

model StaffCollectionCenter {
    id                 Int        @id @default(autoincrement()) @db.Int
    staffId            Int        @map("staff_id") @db.Int
    collectionCenterId Int        @map("collection_center_id") @db.Int
    isMainLab          MainLab    @map("is_main_lab")
    addedOn            DateTime   @default(now()) @map("added_on") @db.DateTime(0)
    modifiedOn         DateTime   @updatedAt @map("modified_on") @db.DateTime(0)
    isActive           BinaryFlag @map("is_active")

    collectionCenter CollectionCenter @relation(fields: [collectionCenterId], references: [id])
    staff            Staff            @relation(fields: [staffId], references: [id])

    @@index([collectionCenterId], name: "staff_collection_center_collection_center_id_idx")
    @@index([staffId], name: "staff_collection_center_staff_id_idx")
    @@map("staff_collection_center")
}

