    barcodePrefix              String                     @map("barcode_prefix") @db.VarChar(50)
    invoicePrefix              String                     @map("invoice_prefix") @db.VarChar(50)
    disabledOn                 DateTime?                  @map("disabled_on")
    disabledBy                 String                     @default("") @map("disabled_by") @db.VarChar(100)
    createdAt                  DateTime                   @default(now()) @map("created_at")
    updatedAt                  DateTime                   @updatedAt @map("updated_at")
