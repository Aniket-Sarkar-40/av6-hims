model ServiceEvent {
    id                   Int           @id @default(autoincrement())
    service              ServiceCode   @default(OPD)
    serviceDomain        ServiceDomain @default(AV6) @map("service_domain")
    allowEmail           Boolean       @default(false) @map("allow_email")
    allowSms             Boolean       @default(false) @map("allow_sms")
    allowWhatsapp        Boolean       @default(false) @map("allow_whatsapp")
    allowAppNotification Boolean       @default(false) @map("allow_app_notification")
    allowWebNotification Boolean       @default(false) @map("allow_web_notification")

    // WhatsApp
    masterPhone String? @map("master_phone")
    wpApiUrl    String? @map("wp_api_url")
    wpApiKey    String? @map("wp_api_key") @db.Text
    countryCode String? @default("+91") @map("country_code")
    wpLanguage  String? @default("en") @map("wp_language")
    wpCallback  String? @map("wp_callback_data")

    // SMS
    smsApiUrl   String? @map("sms_api_url")
    smsApiKey   String? @map("sms_api_key") @db.Text
    smsSenderId String? @map("sms_sender_id")

    // app notification
    appNotificationApiUrl String? @map("app_notification_api_url")

    createdBy Int?     @map("created_by")
    updatedBy Int?     @map("updated_by")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    eventConfig     EventConfig[]
    eventDeliveries EventDelivery[]

    @@map("core_service_event")
}

model EventConfig {
    id                   Int     @id @default(autoincrement())
    serviceEventId       Int     @map("service_event_id")
    eventName            String  @map("event_name")
    shortCode            String  @map("short_code")
    allowEmail           Boolean @default(false) @map("allow_email")
    allowSms             Boolean @default(false) @map("allow_sms")
    allowWhatsapp        Boolean @default(false) @map("allow_whatsapp")
    allowAppNotification Boolean @default(false) @map("allow_app_notification")
    allowWebNotification Boolean @default(false) @map("allow_web_notification")

    // emailTemplateId              Int? @map("email_template_id")
    // smsTemplateId                Int? @map("sms_template_id")
    // wpTemplateId                 Int? @map("wp_template_id")
    // appNotificationTemplateId    Int? @map("app_notification_template_id")
    // webNotificationTemplateId    Int? @map("web_notification_template_id")
    // webNotificationUrlTemplateId Int? @map("web_notification_url_template_id")
    // appNotificationUrlTemplateId Int? @map("app_notification_url_template_id")

    attachmentRequired AttachmentRequired   @default(NOT_REQUIRED) @map("attachment_required")
    notificationType   NotificationType     @default(INFO) @map("notification_type")
    priority           NotificationPriority @default(SECONDARY) @map("priority")
    channelId          String?              @map("channel_id")

    createdBy Int?     @map("created_by")
    updatedBy Int?     @map("updated_by")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    serviceEvent        ServiceEvent         @relation(fields: [serviceEventId], references: [id])
    eventConfigKeys     EventConfigKey[]
    eventRecipientRules EventRecipientRule[]
    eventDeliveries     EventDelivery[]
    templates           Template[]

    @@unique([serviceEventId, eventName])
    @@map("core_service_event_config")
}

model EventConfigKey {
    id            Int    @id @default(autoincrement())
    key           String @map("key")
    defaultValue  String @map("default_value")
    eventConfigId Int    @map("event_config_id")

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")

    eventConfig EventConfig @relation(fields: [eventConfigId], references: [id])

    @@index([eventConfigId], map: "event_config_key_event_config_id_idx")
    @@map("core_event_config_key")
}

model EventRecipientRule {
    id            Int                 @id @default(autoincrement())
    eventConfigId Int                 @map("event_config_id")
    templateType  TemplateType        @map("template_type")
    sourceType    RecipientSourceType @map("source_type")

    /**
     * - WEB_NOTIFICATION:
     * - HARDCODE recipients: {userId, level1Id, level2Id?}[]
     * - KEY_VALUE recipients: {userId:key, level1Id:key, level2Id?:key}[]
     * - STAFFS recipients: {userId, level1Id, level2Id?}[]
     * - ROLES recipients: {roleId, level1Id, level2Id?}[]
     * - Other notification types:
     * - HARDCODE recipients: string[]
     * - KEY_VALUE recipients: string[] (keys array)
     * - STAFFS recipients: number[] (array of staff ids)
     * - ROLES recipients: {roleId, level1Id, level2Id?}[]
     */
    config Json

    isActive  Boolean   @default(true) @map("is_active")
    sortOrder Int       @default(0) @map("sort_order")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")

    eventConfig EventConfig @relation(fields: [eventConfigId], references: [id])

    @@index([eventConfigId, templateType])
    @@map("core_event_recipient_rule")
}

model Notification {
    id       Int  @id @default(autoincrement())
    level1Id Int  @map("cc_id")
    roleId   Int? @map("role_id")
    userId   Int? @map("user_id")

    source   ServiceCode
    type     NotificationType     @default(INFO)
    priority NotificationPriority @default(SECONDARY)

    actionType String? @map("action_type") @db.VarChar(100)
    message    String  @db.Text
    link       String? @db.VarChar(255)

    isRead Boolean   @default(false) @map("is_read")
    readAt DateTime? @map("read_at")

