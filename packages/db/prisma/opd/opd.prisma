model Appointment {
    id              Int             @id @default(autoincrement())
    appointmentId   String          @map("appointment_id")
    patientUniqueId Int             @map("patient_unique_id")
    patientId       Int             @map("patient_id")
    ccId            Int             @map("cc_id")
    doctorId        Int             @map("doctor_id")
    clientId        Int?            @map("client_id")
    visitId         String?         @map("visit_id")
    weekId          Int             @map("week_id")
    appointmentType AppointmentType @map("appointment_type")
    contactNumber   String          @map("contact_number")
    reason          String?         @map("reason") @db.Text

    isVipBooking     Boolean? @map("is_vip_booking")
    isSpecialBooking Boolean? @map("is_special_booking")

    subtotalAmount    Float @default(0) @map("sub_total_amount")
    otherChargeAmount Float @default(0) @map("other_charge_amount")

    taxMethod TAX_METHOD @default(EXCLUSIVE) @map("tax_method")
    taxValue  Float      @default(0) @map("tax_value")
    taxAmount Float      @default(0) @map("tax_amount")

    additionalDiscountMode  PercentageOrAmount? @map("additional_discount_mode")
    additionalDiscountValue Float?              @default(0) @map("additional_discount_value")
    discountTotalAmount     Float               @default(0) @map("discount_total_amount")

    netAmount      Float @default(0) @map("net_amount")
    grossAmount    Float @default(0) @map("gross_amount")
    paidAmount     Float @default(0) @map("paid_amount")
    refundAmount   Float @default(0) @map("refund_amount")
    refundedAmount Float @default(0) @map("refunded_amount")

    // Insurance Information
    insuranceId        Int? @map("insurance_id")
    patientInsuranceId Int? @map("patient_insurance_id")

    coPaymentType   PercentageOrAmount? @default(PERCENTAGE) @map("copayment_type")
    coPaymentValue  Float?              @default(0) @map("copayment_value")
    coPaymentAmount Float?              @default(0) @map("copayment_amount")
    coPaymentSource CoPaymentSource     @default(SETTINGS) @map("copayment_source")

    // Payment Status and Appointment Status
    paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
    status        AptStatus     @default(BOOKED) @map("status")
    billId        String?       @map("bill_id")
    referredBy    ReferredBy?   @map("referred_by")
    isFoc         Boolean?      @default(false) @map("is_foc")
    focBillReason FocBillReason @default(NONE) @map("foc_bill_reason")
    isMigrated    Boolean?      @default(false) @map("is_migrated")
    isRescheduled Boolean       @default(false) @map("is_rescheduled")

    procedureStatus ModuleStatus? @map("procedure_status")
    pharmacyStatus  ModuleStatus? @map("pharmacy_status")

    // Date Time Information
    selectedDate DateTime @map("selected_date") @db.Date
    selectedTime String   @map("selected_time")

    // Cancellation Information
    cancellationReason String?   @map("cancellation_reason")
    cancelledBy        Int?      @map("cancelled_by")
    cancelledAt        DateTime? @map("cancelled_at")

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    deletedBy Int?      @map("deleted_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    patient                Patient                  @relation(fields: [patientId], references: [id])
    doctor                 Staff                    @relation(fields: [doctorId], references: [id])
    client                 ClientMaster?            @relation(fields: [clientId], references: [id])
    cc                     CollectionCenter         @relation(fields: [ccId], references: [id])
    patientConsultation    PatientConsultation[]
    consultationComplaint  ConsultationComplaint[]
    patientAdviceDetails   PatientAdviceDetails[]
    clinicalHistory        ClinicalHistory[]
    patientFollowUp        PatientFollowUp[]
    patientDocument        PatientDocument[]
    consultationIcdTenList ConsultationICDTenList[]
    insurance              InsuranceMaster?         @relation(fields: [insuranceId], references: [id])
    consultation           Consultation[]
    patientTest            PatientTest[]
    patientInsurance       PatientInsurance?        @relation(fields: [patientInsuranceId], references: [id])

    patientReferToDoctor    PatientReferToDoctor[]
    financialChangeRequests FinancialChangeRequest[]
    timeSlots               TimeSlot[]
    patientProcedures       PatientProcedure[]
    patientMedicines        PatientMedicine[]

    @@index([patientId], name: "appointments_table_patient_id_idx")
    @@index([doctorId], name: "appointments_table_doctor_id_idx")
    @@index([ccId], name: "appointments_table_cc_id_idx")
    @@index([clientId], name: "appointments_table_client_id_idx")
    @@index([insuranceId], name: "appointments_table_insurance_id_idx")
    @@index([patientInsuranceId], name: "appointments_table_patient_insurance_id_idx")
    @@map("nopd_appointments")
}

