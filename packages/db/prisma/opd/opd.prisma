model PatientConsultation {
    id            Int @id @default(autoincrement())
    appointmentId Int @map("appointment_id")
    patientId     Int @map("patient_id")

    temperature           Float       @default(0.00) @map("temperature")
    weight                Float       @default(0.00) @map("weight")
    bloodPressure         String?     @map("blood_pressure") @db.VarChar(20)
    spO2                  Int?        @map("spO2")
    pulse                 Int?        @map("pulse")
    notes                 String?     @db.Text
    height                Float       @default(0.00) @map("height")
    bloodGroup            BloodGroup? @map("blood_group")
    bmi                   Float       @default(0.00) @map("bmi")
    systolicBp            Int?        @map("systolic_bp")
    diastolicBp           Int?        @map("diastolic_bp")
    respiratoryRate       Int?        @map("respiratory_rate")
    heartRateBpm          Int?        @map("heart_rate_bpm")
    urineOutput           Float?      @default(0.00) @map("urine_output")
    bloodSugarF           Float?      @default(0.00) @map("blood_sugar_f")
    bloodSugarR           Float?      @default(0.00) @map("blood_sugar_r")
    oxygenSupplementation Int?        @map("oxygen_supplementation")
    intake                Float?      @default(0.00) @map("intake")
    output                Float?      @default(0.00) @map("output")
