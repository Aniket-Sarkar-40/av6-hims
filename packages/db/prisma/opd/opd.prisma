    patient     Patient?    @relation(fields: [patientId], references: [id])

    @@index([appointmentId], name: "patient_consultation_appointment_id_idx")
    @@index([patientId], name: "patient_consultation_patient_id_idx")
    @@map("nopd_patient_consultation")
}

