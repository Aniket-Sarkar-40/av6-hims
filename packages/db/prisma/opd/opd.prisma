model GeneralBillPricing {
    id                Int     @id @default(autoincrement())
    ccId              Int     @map("cc_id")
    generalBillItemId Int     @map("general_bill_item_id")
    description       String? @map("description")
    price             Float   @map("price")

    isActive         Boolean          @default(true) @map("is_active")
    createdBy        Int?             @map("created_by")
    updatedBy        Int?             @map("updated_by")
    deletedBy        Int?             @map("deleted_by")
    createdAt        DateTime         @default(now()) @map("created_at")
    updatedAt        DateTime         @updatedAt @map("updated_at")
    deletedAt        DateTime?        @map("deleted_at")
    collectionCenter CollectionCenter @relation(fields: [ccId], references: [id])
    generalBillItem  GeneralBillItem  @relation(fields: [generalBillItemId], references: [id])

    @@index([ccId], name: "general_bill_pricing_cc_id_idx")
    @@index([generalBillItemId], name: "general_bill_pricing_general_bill_item_id_idx")
    @@map("nopd_general_bill_pricing")
}

model OpdBatchJob {
    id Int @id @default(autoincrement())

    type         Opd_Batch_Type
    status       Batch_Status   @default(PENDING)
    batchJobNo   String?        @map("batch_job_no")
    totalQty     Int            @map("total_qty")
    processedQty Int            @default(0) @map("processed_qty")
    successCount Int            @default(0) @map("success_count")
    failureCount Int            @default(0) @map("failure_count")

    createdAt               DateTime                  @default(now()) @map("created_at")
    updatedAt               DateTime                  @updatedAt @map("updated_at")
    generalBillPricingExcel GeneralBillPricingExcel[]
    batchJobDetails         BatchJobDetails[]

    @@map("nopd_batch_job")
}

model BatchJobDetails {
    id Int @id @default(autoincrement())

    batchId  Int                  @map("batch_id")
    type     BT_JOB_DET_TYPE      @default(CREATE)
    rowTitle String?              @map("row_title")
    rowNo    Int?                 @map("row_no")
    refId    Int?                 @map("ref_id")
    refNo    String?              @map("ref_no")
    status   Batch_Details_Status
    errorMsg String?              @map("error_msg") @db.Text

    batch OpdBatchJob @relation(fields: [batchId], references: [id])

    @@index([batchId], name: "batch_job_details_batch_id_idx")
    @@map("nopd_batch_job_details")
}

model GeneralBillPricingExcel {
    id                  Int    @id @default(autoincrement())
    ccId                Int    @map("cc_id")
    generalBillItemId   Int    @map("general_bill_item_id")
    generalBillItemName String @map("general_bill_item_name")
    price               Int    @map("price")
    description         String @map("description")
    batchJobId          Int    @map("batch_job_id")

    batchJob OpdBatchJob @relation(fields: [batchJobId], references: [id])

    @@index([batchJobId], name: "general_bill_pricing_excel_batch_job_id_idx")
    @@map("nopd_general_bill_pricing_excel")
}

model GeneralBilling {
    id              Int @id @default(autoincrement())
    ccId            Int @map("cc_id")
    patientId       Int @map("patient_id")
    patientUniqueId Int @map("patient_unique_id")

    additionalDiscountMode  PercentageOrAmount? @map("additional_discount_mode")
    additionalDiscountValue Float               @default(0) @map("additional_discount_value")

    subtotalAmount      Float @default(0) @map("subtotal_amount")
    otherChargeAmount   Float @default(0) @map("other_charge_amount")
    discountTotalAmount Float @default(0) @map("discount_total_amount")

    taxAmount   Float @default(0) @map("tax_amount")
    grossAmount Float @default(0) @map("gross_amount")
    netAmount   Float @default(0) @map("net_amount")

    paidAmount     Float @default(0) @map("paid_amount")
    refundAmount   Float @default(0) @map("refund_amount")
    refundedAmount Float @default(0) @map("refunded_amount")

    billNumber String  @map("bill_number")
    remark     String? @map("remark")

    paymentStatus PaymentStatus        @default(PENDING) @map("payment_status")
    status        GeneralBillingStatus @default(COMPLETED)

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    deletedBy Int?      @map("deleted_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    collectionCenter      CollectionCenter        @relation(fields: [ccId], references: [id])
    patient               Patient                 @relation(fields: [patientId], references: [id])
    generalBillingDetails GeneralBillingDetails[]

    @@index([ccId], name: "patient_procedure_cc_id_idx")
    @@index([patientId], name: "patient_procedure_patient_id_idx")
    @@map("nopd_general_billing")
}

model GeneralBillingDetails {
    id                Int @id @default(autoincrement())
    generalBillingId  Int @map("general_billing_id")
    generalBillItemId Int @map("general_bill_item_id")

    subtotalAmount    Float @default(0) @map("subtotal_amount")
    otherChargeAmount Float @default(0) @map("other_charge_amount")

    discountMode   PercentageOrAmount? @map("discount_mode")
    discountValue  Float               @default(0) @map("discount_value")
    discountAmount Float               @default(0) @map("discount_amount")

    taxMethod TAX_METHOD? @map("tax_method")
    taxValue  Float       @default(0) @map("tax_value")
    taxAmount Float       @default(0) @map("tax_amount")

    grossAmount Float @map("gross_amount")
    netAmount   Float @map("net_amount")

    isRefunded Boolean @default(false) @map("is_refunded")
    isFoc      Boolean @default(false) @map("is_foc")

    isActive  Boolean   @default(true) @map("is_active")
    createdBy Int?      @map("created_by")
    updatedBy Int?      @map("updated_by")
    deletedBy Int?      @map("deleted_by")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    generalBilling  GeneralBilling  @relation(fields: [generalBillingId], references: [id])
    generalBillItem GeneralBillItem @relation(fields: [generalBillItemId], references: [id])

    @@index([generalBillingId], name: "general_billing_details_general_billing_id_idx")
    @@index([generalBillItemId], name: "general_billing_details_general_item_pricing_id_idx")
    @@map("nopd_general_billing_details")
}
