{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "../platform/src/validation/logger.utils.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "logs",
    "uploads",
    "coverage",
    ".turbo",
    ".cache",
    "tmp"
  ]
}
