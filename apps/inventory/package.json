{
  "name": "@apps/inv",
  "version": "0.0.1",
  "dependencies": {
    "@apps/acc": "workspace:*",
    "@apps/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/platform": "workspace:*",
    "@repo/shared": "workspace:*",
    "av6-core-v2": "^1.0.5",
    "av6-pdf-engine": "^3.0.1",
    "av6-utils": "^1.0.6",
    "dayjs": "catalog:",
    "exceljs": "catalog:",
    "express": "catalog:",
    "handlebars": "^4.7.8",
    "joi": "catalog:",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "puppeteer": "^24.13.0",
    "xlsx": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "eslint": "^9.15.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "main": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "node --conditions=development --enable-source-maps --import tsx --import ../../tooling/register-dev-hooks.mjs --watch src/server.ts",
    "lint": "eslint .",
    "start": "node dist/src/server.js",
    "test": "vitest run"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
