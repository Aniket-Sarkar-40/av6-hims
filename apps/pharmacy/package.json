{
  "name": "@apps/pharmacy",
  "version": "0.0.1",
  "dependencies": {
    "@apps/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/platform": "workspace:*",
    "@repo/shared": "workspace:*",
    "av6-core-v2": "^1.0.5",
    "av6-utils": "^1.0.6",
    "axios": "^1.13.6",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "dayjs": "^1.11.19",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "joi": "^17.13.3",
    "node-cron": "^4.2.1",
    "node-thermal-printer": "^4.6.0",
    "to-words": "^5.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "main": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "node --conditions=development --enable-source-maps --import tsx --import ../../tooling/register-dev-hooks.mjs --watch src/server.ts",
    "lint": "echo lint core",
    "start": "node dist/src/server.js",
    "test": "echo test core"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
