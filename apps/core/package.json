{
  "name": "@apps/core",
  "version": "0.0.1",
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/platform": "workspace:*",
    "@repo/shared": "workspace:*",
    "av6-core-v2": "^1.0.5",
    "av6-pdf-engine": "^3.0.1",
    "av6-utils": "^1.0.6",
    "axios": "catalog:",
    "dayjs": "catalog:",
    "exceljs": "catalog:",
    "express": "catalog:",
    "joi": "catalog:",
    "jsonwebtoken": "^9.0.3",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^9.15.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "main": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "node --conditions=development --enable-source-maps --import tsx --import ../../tooling/register-dev-hooks.mjs --watch src/server.ts",
    "lint": "eslint .",
    "start": "node dist/src/server.js",
    "test": "vitest run"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
