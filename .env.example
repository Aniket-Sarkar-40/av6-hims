# Copy to .env and fill in real values. Variables without a default are REQUIRED
# and the app will refuse to start (fail-fast) if they are missing.

# --- App ---
PORT=4507
NODE_ENV=DEVELOPMENT
BASE_URL=http://localhost:4002
FRONTEND_URLS=http://localhost:3005,http://localhost:4501

# --- Database ---
DATABASE_URL="mysql://root:@localhost:3306/monorepo_hims"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=monorepo_hims
# Optional: connection pool size (default 10)
DATABASE_CONNECTION_LIMIT=10

# --- Redis ---
IS_REDIS=true
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_PREFIX=turbo:

# --- Secrets (REQUIRED - no in-code defaults) ---
JWT_SECRET=
SMTP_PASSWORD=
EMAIL_PASSWORD=
# Required only when TOKEN_VERSION=V2
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_SECRET=
TOKEN_VERSION=V1

# --- Auth / misc ---
CLIENT_ID=
JWT_TOKEN=access-token-av6
API_TIMEOUT=60000
DOC_DESG_ID=2

# --- External services ---
EXT_LOGIN_URL=
EXT_ROLE_PERM_URL=
EXT_USER_DETAILS_URL=
EXT_CHANGE_ROLE_URL=
EXT_ROLE_BY_CC_URL=
EXT_CONNECTION_TYPE=pms
EXT_PHARMACY_ITEM_URL=

# --- SMTP / Email ---
SMTP_HOST=mail.aerialview6.com
SMTP_PORT=465
SMTP_USER=your@aerialview6.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=test@gmail.com
EMAIL_SSL_TLS=tls

# --- Storage (Hetzner S3) ---
HETZNER_ACCESS_KEY=
HETZNER_SECRET_KEY=
HETZNER_BUCKET=
HETZNER_REGION=
HETZNER_ENDPOINT=

# --- Gateway ---
ENABLED_APPS=core,opd,pms,inv
